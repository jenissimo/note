/* note.rc — the resources compiled into note.exe.
 *
 * The icon has to be a resource rather than something loaded at runtime:
 * Explorer draws the icon for an executable by reading RT_GROUP_ICON out of
 * the file itself, without ever running it, so an icon fetched from a system
 * DLL at startup would dress the window and the taskbar button but leave the
 * file looking blank in a folder.
 *
 * assets/note.ico is generated by tools/make_icon.py.
 */

#include <windows.h>
#include "note_res.h"

IDI_NOTE ICON "..\\assets\\note.ico"

/* The curated language pack, so note.exe is a complete editor on its own
 * rather than two files that have to travel together.  It is compiled by
 * tools\compress_packs.ps1 into the build directory, which build.bat passes
 * to rc as an include path -- so it is named here without one, and a build
 * sent elsewhere by NOTE_OUT still finds its own.  build.bat defines
 * HAVE_PACKS only once it exists — without it the executable still runs,
 * with no languages but whatever it finds on disk beside it.
 *
 * The curated theme pack is not here.  It is appended to the executable after
 * the link, because the 16-bit MS-DOS editor in this file's MZ stub reads it
 * too and cannot reach a PE resource; see build.bat and h_overlay_pack() in
 * src\platform\win32\win32_host.c. */
#ifdef HAVE_PACKS
IDR_CORE_SYNTAX RT_NOTEPACK "core.syntax.lz"
#endif

/* The version block is what the file's Properties page and most installers
 * read; without one the executable shows no product or version at all. */
VS_VERSION_INFO VERSIONINFO
    FILEVERSION     0,1,0,0
    PRODUCTVERSION  0,1,0,0
    FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
    FILEFLAGS       0
    FILEOS          VOS_NT_WINDOWS32
    FILETYPE        VFT_APP
    FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"          /* US English, Unicode */
        BEGIN
            VALUE "FileDescription", "note - a small, fast text editor"
            VALUE "FileVersion",     "0.1.0.0"
            VALUE "InternalName",    "note"
            VALUE "OriginalFilename","note.exe"
            VALUE "ProductName",     "note"
            VALUE "ProductVersion",  "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 0x04B0
    END
END
