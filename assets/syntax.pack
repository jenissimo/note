# Converted from micro's 'cmake.yaml' syntax file.
# Upstream: zyedidia/micro (MIT). See NOTICE.md.
# Lossy on purpose: note's lexer keeps word lists and
# delimiters, not micro's regular expressions.

name = CMake
extensions = cmake
line_comment = #
quotes = "'
preproc = yes
keywords = APPLE UNIX WIN32 CYGWIN BORLAND MINGW
rule = type ^[ \t\r\n\f\v]*[A-Z0-9_]+
rule = preproc ^[ \t\r\n\f\v]*(include|include_directories|include_external_msproject)\b
rule = keyword ^[ \t\r\n\f\v]*\b((else|end)?if|else|(end)?while|(end)?foreach|break)\b
rule = keyword \b(COPY|NOT|COMMAND|PROPERTY|POLICY|TARGET|EXISTS|IS_(DIRECTORY|ABSOLUTE)|DEFINED)\b[ \t\r\n\f\v]
rule = keyword [ \t\r\n\f\v]\b(OR|AND|IS_NEWER_THAN|MATCHES|(STR|VERSION_)?(LESS|GREATER|EQUAL))\b[ \t\r\n\f\v]
rule = operator ^[ \t\r\n\f\v]*\b((end)?(function|macro)|return)
rule = type \b(MSVC(_IDE|60|71|80|90)?)\b
