rule = keyword \b(infix(l|r)?|(pre|post|non)fix)\b
rule = keyword \b(sta(tic)?|v?typedef)\b
rule = keyword \b((pr)?va(l|r)|withv(iew)?type)\b
rule = keyword \b(abst[@0]ype|absviewt[@0]?ype|absvt[@0]ype)\b
rule = keyword \b(case[+-]|(pr)?va(l|r)[+-]|for\*|while\*)
rule = number \b[0-9.]+([eE][+-]?[0-9]+)?[fFlL]?\b
rule = number \b0[xX][0-9A-Fa-f]*(\.[0-9A-Fa-f]*)?[pP][+-]?[0-9]+[fFlL]?\b
