rule = number \b[0-9]+\b
rule = keyword (\{|\}|\(|\)|\;|\]|\[|`|\\|\$|<|>|!|=|&|\|)
rule = operator -[Ldefgruwx]\b
rule = operator -(eq|ne|gt|lt|ge|le|s|n|z)\b
rule = keyword \b((un)?alias)\b
rule = type \b(add-zsh-hook|(dis|en)able|prompt(init)?|(un)?setopt)\b
