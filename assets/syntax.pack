# Converted from micro's 'micro.yaml' syntax file.
# Upstream: zyedidia/micro (MIT). See NOTICE.md.
# Lossy on purpose: note's lexer keeps word lists and
# delimiters, not micro's regular expressions.

name = Micro
extensions = micro
line_comment = #
quotes = "
keywords = syntax default number statement underlined error todo statusline ignore divider tabbar
rule = keyword \b(color(-link)?)\b
rule = keyword \b(start=|end=)\b
rule = type \b(indent-char|cursor\-line|color\-column)\b
rule = type \b(special(Char)?)\b
rule = type \b((current\-)?line\-number)\b
rule = type \b(gutter\-(info|error|warning){1})\b
rule = type \b(comment(\.bright)?)\b
rule = type \b(symbol(\.(brackets|operator|tag))?)\b
rule = type \b(identifier(\.(class|macro|var))?)\b
rule = type \b(constant(\.(bool(\.(true|false){1})?|number|specialChar|string(\.url)?){1})?)\b
rule = type \b(preproc(\.shebang)?)\b
rule = type \b(type(\.keyword)?)\b
rule = number \b(|h|A|0x)+[0-9]+(|h|A)+\b
rule = number \b0x[0-9 a-f A-F]+\b
rule = number #[0-9 A-F a-f]+
