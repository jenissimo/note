# Converted from micro's 'crontab.yaml' syntax file.
# Upstream: zyedidia/micro (MIT). See NOTICE.md.
# Lossy on purpose: note's lexer keeps word lists and
# delimiters, not micro's regular expressions.

name = Crontab
extensions = crontab
line_comment = #
keywords = jan feb mar apr may jun jul aug sep oct nov dec sun mon tue wed thu fri sat
rule = keyword ^([\*0-9,\-\/]+)\s+([\*0-9,\-\/]+)\s+([\*0-9,\-\/]+)\s+(([\*0-9,\-\/]+)|(\b(jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)\b))\s+(([\*0-9,\-\/]+)|(\b(sun|mon|tue|wed|thu|fri|sat)\b))\s+(.*)$\n?
rule = number ^([\*0-9,\-\/]+)\s+([\*0-9,\-\/]+)\s+([\*0-9,\-\/]+)\s+(([\*0-9,\-\/]+)|(\b(jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)\b))\s+(([\*0-9,\-\/]+)|(\b(sun|mon|tue|wed|thu|fri|sat)\b))
rule = type ^[A-Z]+\=
rule = type \@(reboot|yearly|annually|monthly|weekly|daily|midnight|hourly)\b
rule = operator (\{|\}|\(|\)|\;|\]|\[|`|\\|\$|<|>|^|!|=|&|\|)
---
# Converted from micro's 'crystal.yaml' syntax file.
# Upstream: zyedidia/micro (MIT). See NOTICE.md.
# Lossy on purpose: note's lexer keeps word lists and
# delimiters, not micro's regular expressions.

name = Crystal
extensions = cr
line_comment = #
quotes = `"'
keywords = abstract alias as asm begin break case class def do else elsif end ensure enum extend for fun if in include instance_sizeof lib loop macro module next of out pointerof private protected raise require rescue return select self sizeof spawn struct super then type typeof uninitialized union unless until verbatim when while with yield true false nil __FILE__ __LINE__
rule = number \b[0-9]+\b
rule = keyword \b(nil\?|as(\?|\b)|is_a\?|responds_to\?)
rule = type (\$|@|@@)?\b[A-Z]+[0-9A-Z_a-z]*
rule = number ([ 	]|^):[0-9A-Z_]+\b
rule = number /([^/]|(\\/))*/[iomx]*|%r\{([^}]|(\\}))*\}[iomx]*
rule = number `[^`]*`|%x\{[^}]*\}
