rule = keyword \b((sha1|sha224|sha256|sha384|sha512)sum)\b
rule = type ^\s+(function\s+)[0-9A-Z_]+\s+\(\)
rule = type \$\{?[0-9A-Z_!@#$*?-]+\}?
