line_comment = #
quotes = "
keywords = hook policy priority type state ct iif iifname meta oif oifname th dport sport saddr daddr l4proto accept drop goto jump log masquerade reject limit queue add define flush include delete
types = chain counter map rule ruleset set table ether inet tcp udp
rule = type \b(i(cm)?p(x|(v?(4|6))?)|8021q)\b
