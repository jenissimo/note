rule = number \b[0-9]+(\.[0-9]+)?([ \t\r\n\f\v](pt|mm|cm|in|ex|em|bp|pc|dd|cc|nd|nc|sp))?\b
rule = operator [&\\]
rule = keyword \\@?[a-zA-Z_]+
rule = keyword \\%
