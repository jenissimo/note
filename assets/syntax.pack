name = Objective-C
extensions = m mm
line_comment = //
block_comment = /* */
quotes = "
preproc = yes
keywords = class namespace template public protected private typename this friend virtual using mutable volatile register explicit for if while do else case default switch try throw catch operator new delete goto continue break return nonatomic atomic readonly readwrite strong weak assign nil NULL YES NO TRUE true FALSE false self
types = float double CGFloat id bool BOOL Boolean char int short long sizeof enum void static const struct union typedef extern inline Class SEL IMP
rule = type \b((un)?signed|NS(U)?Integer)\b
rule = type \b((s?size)|((u_?)?int(8|16|32|64|ptr)))_t\b
rule = type \b[A-Z][A-Z][0-9A-Za-z]*\b
rule = type \b[A-Za-z0-9_]*_t\b
rule = type \bdispatch_[a-zA-Z0-9_]*_t\b
rule = keyword (__attribute__[ \t\r\n\f\v]*\(\([^)]*\)\)|__(aligned|asm|builtin|hidden|inline|packed|restrict|section|typeof|weak)__|__unused|_Nonnull|_Nullable|__block|__builtin.*)
rule = keyword @(encode|end|interface|implementation|class|selector|protocol|synchronized|try|catch|finally|property|optional|required|import|autoreleasepool)
rule = preproc ^[ \t\r\n\f\v]*#[ \t\r\n\f\v]*(define|include|import|(un|ifn?)def|endif|el(if|se)|if|warning|error|pragma).*$
rule = preproc __[A-Z0-9_]*__
rule = operator ^[ \t\r\n\f\v]*[#|@][ \t\r\n\f\v]*(import|include)[ \t\r\n\f\v]*["|<].*\/?[>|"][ \t\r\n\f\v]*$
rule = keyword ([.:;,+*|=!\%\[\]]|<|>|/|-|&)
rule = number (\b(-?)?[0-9]+\b|\b\[0-9]+\.[0-9]+\b|\b0x[0-9a-fA-F]+\b)
rule = number (@\[(\\.|[^\]])*\]|@\{(\\.|[^\}])*\}|@\((\\.|[^\)])*\))
rule = number \b<(\\.[^\>])*\>\b
rule = number \bk[[:alnum]]*\b
rule = number '.'
