rule = keyword ^[ \t\r\n\f\v]*#[ \t\r\n\f\v]*(define|include(_next)?|(un|ifn?)def|endif|el(if|se)|if|warning|error|pragma)
rule = number (__attribute__[ \t\r\n\f\v]*\(\([^)]*\)\)|__(aligned|asm|builtin|hidden|inline|packed|restrict|section|typeof|weak)__)
