# Converted from micro's 'csharp.yaml' syntax file.
# Upstream: zyedidia/micro (MIT). See NOTICE.md.
# Lossy on purpose: note's lexer keeps word lists and
# delimiters, not micro's regular expressions.

name = C#
extensions = cs
line_comment = //
block_comment = /* */
quotes = "'
preproc = yes
keywords = alias as case catch checked default do dynamic else finally fixed for foreach goto if is lock new null return switch throw try unchecked when while with abstract add and args async await class const delegate enum event explicit extern file get global implicit in init internal interface nameof namespace not notnull operator or out override params partial private protected public readonly record ref remove required scoped sealed set sizeof stackalloc static struct typeof unsafe using value virtual volatile yield from where select group info orderby join let on equals by ascending descending break continue true false
types = bool byte sbyte char decimal double float IntPtr int uint long ulong managed unmanaged nint nuint object short ushort string base this var void
rule = type class +[A-Za-z0-9]+ *((:) +[A-Za-z0-9.]+)?
rule = type @[A-Za-z]+
rule = preproc ^[ \t\r\n\f\v]*#[ \t\r\n\f\v]*(define|elif|else|endif|endregion|error|if|line|nullable|pragma|region|undef|warning)
rule = type ([A-Za-z0-9_]*[ \t\r\n\f\v]*[()])
rule = operator [\-+/*=<>?:!~%&|]
rule = number \b([0-9._]+|0x[A-Fa-f0-9_]+|0b[0-1_]+)[FL]?\b
