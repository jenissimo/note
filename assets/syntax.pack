# Converted from micro's 'cuda.yaml' syntax file.
# Upstream: zyedidia/micro (MIT). See NOTICE.md.
# Lossy on purpose: note's lexer keeps word lists and
# delimiters, not micro's regular expressions.

name = Cuda
extensions = cuda
line_comment = //
block_comment = /* */
quotes = "'
preproc = yes
keywords = class namespace template typename this friend using public protected private noexcept concept requires import export module for if while do else case default switch try throw catch operator new delete static_assert goto continue break return asm fortran true false NULL nullptr
types = float double bool char int short long enum void struct union typedef inline wchar_t final override auto volatile mutable register thread_local static extern decltype explicit virtual
rule = type \b[A-Z_][0-9A-Z_]*\b
rule = type \b((un)?signed)\b
rule = type \b(((s?size)|((u_?)?int(8|16|32|64|ptr))|char(8|16|32))_t)\b
rule = type \b[a-z_][0-9a-z_]+(_t|_T)\b
rule = type \b(const(expr|eval|init)?)\b
rule = preproc ^[ \t\r\n\f\v]*#[ \t\r\n\f\v]*(define|pragma|include|(un|ifn?)def|endif|el(if|se)|if|warning|error)|_Pragma
rule = keyword (__attribute__[ \t\r\n\f\v]*\(\([^)]*\)\)|__(aligned|asm|builtin|hidden|inline|packed|restrict|section|typeof|weak)__)
rule = keyword __(global|device|host|shared)__
rule = operator [-+*/%=<>.:;,~&|^!?]|\b(sizeof|alignof|typeid|(and|or|xor|not)(_eq)?|bitor|compl|bitand|(const|dynamic|reinterpret|static)_cast)\b
rule = operator [(){}]|\[|\]
rule = number (\b([1-9][0-9']*|0[0-7']*|0[Xx][0-9a-fA-F']+|0[Bb][01]+)([Uu]?[Ll][Ll]?|[Ll][Ll]?[Uu]?)?\b)
rule = number (\b(([0-9']*[.][0-9']+|[0-9']+[.][0-9']*)([Ee][+-]?[0-9']+)?|[0-9']+[Ee][+-]?[0-9']+)[FfLl]?\b)
rule = number (\b0[Xx]([0-9a-zA-Z']*[.][0-9a-zA-Z']+|[0-9a-zA-Z']+[.][0-9a-zA-Z']*)[Pp][+-]?[0-9']+[FfLl]?\b)
