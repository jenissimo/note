keywords = w CRITICAL i DEBUG dbug dbg de d VERBOSE ALERT TRACE Trace NOTICE verb vrb vb v ERROR e FATAL EMERGENCY YES yes Y y ON on TRUE True true NO no N n OFF off FALSE False false None null nil FILE File file
rule = number \b(INFO(RMATION)?|[Ii]nfo(rmation)?|[Ii]n(f)?|I/)\b
