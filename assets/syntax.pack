name = Verilog
extensions = v vh sv svh
line_comment = //
block_comment = /* */
quotes = "
keywords = module package program endmodule endpackage endprogram always and assign automatic begin buf bufif0 bufif1 case casex casez cell cmos config deassign default defparam design disable edge else end endcase endconfig endfunction endgenerate endprimitive endspecify endtable event for force forever fork function generate genvar highz0 highz1 if iff ifnone incdir include initial input instance join large liblist library localparam macromodule medium nand negedge nmos nor noshowcancelled not notif0 notif1 null or output parameter pmos posedge primitive pull0 pull1 pulldown pullup pulsestyle_onevent pulsestyle_ondetect rcmos realtime reg release repeat rnmos rpmos rtran rtranif0 rtranif1 scalared showcancelled small specify specparam strong0 strong1 supply0 supply1 table time tran tranif0 tranif1 tri0 tri1 triand trior trireg use uwire vectored wait wand weak0 weak1 while wor xnor xor alias always_comb always_ff always_latch assert assume before bind bins binsof break chandle clocking const constraint context continue cover covergroup coverpoint cross dist do endclocking endgroup endproperty endsequence enum expect export extends extern final first_match foreach forkjoin ignore_bins illegal_bins import inside intersect join_any join_none local longint matches modport new packed priority property protected pure rand randc randcase randsequence ref return sequence solve static struct super tagged this throughout timeprecision timeunit type typedef union unique virtual wait_order wildcard with within
types = task interface class endtask endinterface endclass int integer logic wire tri unsigned signed inout var shortint shortreal real void string bit byte
rule = operator \$[0-9A-Za-z_]+
rule = number \b[0-9]+\b
rule = number \b'[su]?[dboh][0-9xzXZa-fA-F]+\b
rule = operator \.((\*)|([A-Za-z][A-Za-z0-9_]*))
