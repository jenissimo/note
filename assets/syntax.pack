rule = operator [.:;+`|~<>?='\&]|/|%|-|,|!|\*|@|\#
rule = operator \^
rule = type \b(age?z|int(ptr)?)\b
rule = type \b(v?t0p)\b
rule = type \b(t[@0]ype|viewt[@0]ype|vt[@0]ype)\b
rule = type \b(prop[+-]|t[@0]ype[+-]|type[+-]|viewt[@0]ype[+-]|viewtype[+-]|vt[@0]ype[+-]|vtype[+-]|view[+-])
rule = keyword \b(absvt(ype)?|(re)?assume|(pr)?case|s?case)\b
