# Converted from micro's 'c.yaml' syntax file.
# Upstream: zyedidia/micro (MIT). See NOTICE.md.
# Lossy on purpose: note's lexer keeps word lists and
# delimiters, not micro's regular expressions.

name = C
extensions = c h ii i def
line_comment = //
block_comment = /* */
quotes = "'
preproc = yes
keywords = auto volatile register restrict _Alignas alignas _Alignof alignof static const constexpr extern _Thread_local thread_local for if while do else case default switch _Generic _Static_assert static_assert goto continue break return asm fortran true false NULL nullptr TRUE FALSE
types = _Atomic _BitInt float double _Decimal32 _Decimal64 _Decimal128 _Complex complex _Imaginary imaginary _Bool bool char int short long enum void struct union typedef typeof typeof_unqual inline _Noreturn _Float16 __fp16 _Float32 _Float32x _Float64 _Float64x __float80 _Float128 _Float128x __float128 __ibm128 __int128 _Fract _Sat _Accum
rule = type \b[A-Z_][0-9A-Z_]+\b
rule = type \b((un)?signed)\b
rule = type \b((s?size)|((u_?)?int(8|16|32|64|ptr))|char(8|16|32)|wchar)_t\b
rule = type \b[a-z_][0-9a-z_]+(_t|_T)\b
rule = preproc ^[ \t\r\n\f\v]*#[ \t\r\n\f\v]*(define|embed|pragma|include|(un|ifn?)def|endif|el(if|ifdef|ifndef|se)|if|line|warning|error|__has_include|__has_embed|__has_c_attribute)
rule = preproc ^[ \t\r\n\f\v]*_Pragma\b
rule = keyword __attribute__[ \t\r\n\f\v]*\(\([^)]*\)\)
rule = keyword __(aligned|asm|builtin|extension|hidden|inline|packed|restrict|section|typeof|weak)__
rule = operator [-+*/%=<>.:;,~&|^!?]|\b(offsetof|sizeof)\b
rule = operator [(){}]|\[|\]
rule = number (\b([1-9][0-9]*|0[0-7]*|0[Xx][0-9A-Fa-f]+|0[Bb][01]+)([Uu][Ll]?[Ll]?|[Ll][Ll]?[Uu]?)?\b)
rule = number (\b(([0-9]*[.][0-9]+|[0-9]+[.][0-9]*)([Ee][+-]?[0-9]+)?|[0-9]+[Ee][+-]?[0-9]+)[FfLl]?\b)
rule = number (\b0[Xx]([0-9A-Za-z]*[.][0-9A-Za-z]+|[0-9A-Za-z]+[.][0-9A-Za-z]*)[Pp][+-]?[0-9]+[FfLl]?\b)
