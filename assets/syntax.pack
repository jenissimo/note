keywords = self nil true false ifTrue ifFalse whileTrue whileFalse __FILE__ __LINE__
rule = number (\$|@|@@)?\b[A-Z]+[0-9A-Z_a-z]*
rule = number (i?)([ 	]|^):[0-9A-Z_]+\b
rule = number /([^/]|(\\/))*/[iomx]*|%r\{([^}]|(\\}))*\}[iomx]*
rule = number %[QW]?\{[^}]*\}|%[QW]?\([^)]*\)|%[QW]?<[^>]*>|%[QW]?\[[^]]*\]|%[QW]?\$[^$]*\$|%[QW]?\^[^^]*\^|%[QW]?![^!]*!
rule = number %[qw]\{[^}]*\}|%[qw]\([^)]*\)|%[qw]<[^>]*>|%[qw]\[[^]]*\]|%[qw]\$[^$]*\$|%[qw]\^[^^]*\^|%[qw]![^!]*!
rule = number %[x]\{[^}]*\}|%[x]\([^)]*\)|%[x]<[^>]*>|%[x]\[[^]]*\]|%[x]\$[^$]*\$|%[x]\^[^^]*\^|%[x]![^!]*!
rule = operator [-+/*=<>!~%&|^]|\b:
rule = operator ([(){}]|\[|\])
rule = preproc ^#!.+?( |$)
---
# Converted from micro's 'solidity.yaml' syntax file.
# Upstream: zyedidia/micro (MIT). See NOTICE.md.
# Lossy on purpose: note's lexer keeps word lists and
# delimiters, not micro's regular expressions.

name = Solidity
extensions = sol
line_comment = //
block_comment = /* */
quotes = "'
keywords = contract library pragma assembly break continue do for function if else new return returns while throw now keccak256 sha3 sha256 ripemd160 ecrecover addmod mulmod this super selfdestruct true false wei szabo finney ether seconds minutes hours days weeks years abstract after case catch default final in inline interface let match null of pure relocatable static switch try type typeof view
types = anonymous constant indexed payable public private external internal address bool mapping string var
rule = number \b[-]?([0-9]+|0x[0-9a-fA-F]+)\b
rule = type [a-zA-Z][_a-zA-Z0-9]*[ \t\r\n\f\v]*
rule = operator \b(\.send)\b
rule = number \b(block(\.(blockhash|coinbase|difficulty|gaslimit|number|timestamp))?|msg(\.(data|gas|sender|value))?|tx(\.(gasprice|origin))?)\b
rule = number \b(\.balance)\b
rule = type \b(int(\d*)|uint(\d*)|byte(\d*)|fixed(\d*)|ufixed(\d*))\b
---
# Converted from micro's 'sql.yaml' syntax file.
# Upstream: zyedidia/micro (MIT). See NOTICE.md.
# Lossy on purpose: note's lexer keeps word lists and
# delimiters, not micro's regular expressions.

name = SQL
extensions = sql
preproc = yes
keywords = ON OFF
rule = number \b([0-9]+)\b
rule = number "(\\.|[^"])*"|'(\\.|[^'])*'
rule = number `(\\.|[^\\`])*`
