rule = operator [-+/*=<>!~%?:&|]
rule = keyword \b(agg-groups|all-false|all-true|all?|ansi gradient)\b
rule = keyword \b(ansi strip|any?|arg-max)\b
rule = keyword \b(arg-min|arg-sort|arg-true|arg-unique|as-date)\b
rule = keyword \b(as-datetime|build-string)\b
rule = keyword \b(config env|config nu)\b
rule = keyword \b(count-null|date format|date humanize)\b
rule = keyword \b(date list-timezone|date now|date to-record|date to-table)\b
rule = keyword \b(date to-timezone|db and|db as|db col|db collect)\b
rule = keyword \b(db describe|db fn|db from|db group-by|db join|db limit)\b
rule = keyword \b(db open|db or|db order-by|db over|db query|db schema)\b
rule = keyword \b(db select|db testing|db where)\b
rule = keyword \b(def-env|detect columns)\b
rule = keyword \b(df-not|drop column|drop nth|drop-duplicates)\b
rule = keyword \b(drop-nulls|each while|empty?)\b
rule = keyword \b(error make)\b
rule = keyword \b(export alias|export def|export def-env|export env)\b
rule = keyword \b(export extern|expr-not|fill-na)\b
rule = keyword \b(fill-null|filter-with)\b
rule = keyword \b(format filesize|from csv|from eml)\b
rule = keyword \b(from ics|from ini|from json|from nuon|from ods|from ssv)\b
rule = keyword \b(from toml|from tsv|from url|from vcf|from xlsx|from xml)\b
rule = keyword \b(from yaml|from yml|get-day|get-hour|get-minute)\b
