line_comment = #
block_comment = ### ###
quotes = "'
keywords = await when catch continue debugger default by until delete do else export finally for class extends while then get if import from in instanceof new reject resolve return set super switch this throw try typeof with yield unless true false yes no on off globalThis Infinity null undefined NaN
types = Array Boolean Date Enumerator Error Function Generator Map Math Number Object Promise Proxy Reflect RegExp Set String Symbol WeakMap WeakSet BigInt64Array BigUint64Array Float32Array Float64Array Int16Array
rule = operator ([-+/*=<>!~%?:&|]|[.]{3})|\b(and|or|is|isnt|not)\b
rule = type ([A-Za-z_][A-Za-z0-9_]*:[ \t\r\n\f\v]*(->|\()|->)
rule = operator [()]
rule = number \b[-+]?([1-9][0-9]*|0[0-7]*|0x[0-9a-fA-F]+)([uU][lL]?|[lL][uU]?)?\b
rule = number \b[-+]?([0-9]+\.[0-9]*|[0-9]*\.[0-9]+)([EePp][+-]?[0-9]+)?[fFlL]?
rule = number \b[-+]?([0-9]+[EePp][+-]?[0-9]+)[fFlL]?
rule = type @[A-Za-z0-9_]*
