rule = number [0-9][0-9_]*([eE][+-]?([0-9][0-9_]*))[fFL]?i?
rule = number [^.]\.([0-9][0-9_]*)([eE][+-]?([0-9][0-9_]*))?[fFL]?i?
rule = number [0-9][0-9_]*([fFL]?i|[fF])
rule = number (0[xX]([0-9a-fA-F][0-9a-fA-F_]*|[0-9a-fA-F_]*[0-9a-fA-F]))(L[uU]?|[uU]L?)?
