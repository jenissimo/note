rule = number \b[0-9](_?[0-9])*(\.([0-9](_?[0-9])*)?)?(e[0-9](_?[0-9])*)?\b
rule = number \b0b(_?[01])+\b
rule = number \b0o(_?[0-7])+\b
rule = number \b0x(_?[0-9a-f])+\b
rule = operator ([~^.:;,+*|=!\%]|<|>|/|-|&)
rule = operator ([(){}]|\[|\])
rule = type \b((([Mm]on|[Tt]ues|[Ww]ed(nes)?|[Tt]hur(s)?|[Ff]ri|[Ss]at(ur)?|[Ss]un)(day)?\s)?([Jj]an(uary)?|[Ff]eb(ruary)?|[Mm]ar(ch)?|[Aa]pr(il)?|[Mm]ay|[Jj]un(e)?|[Jj]ul(y)?|[Aa]ug(ust)?|[Aa]go|[Ss]ep(tember)?|[Oo]ct(ober)?|[Nn]ov(ember)?|[Dd]ec(ember)?)\s\d{1,2},?(\s\d{4})?)\b
rule = type \b(\d{2,4}[-/\.]?\d{2,3}[-/\.]?\d{2,4})\b
rule = type \b(\d{2}:\d{2}(:\d{2})?([\.,]?\d{1,8}[\.\+,]?\d{1,8}?)?([\.\+,]?\d{1,8}[\.\+,]?\d{1,8}?)?([\.\+,]?\d{1,8}?)?(\s-\d{0,4})?)\b
rule = type ^([0-2][0-9][0-2][0-9][-/]?[0-9][0-9][-/]?[0-9][0-9])
rule = type ^(\d{4}[-/]?\d{2}[-/]?\d{2}\s\d{2}:\d{2}(:\d{2})?(\.?\d{2,8})?)
rule = type ^([0-2][0-9]|[0-2]-?[0-9][0-9]-?[0-9][0-9])\-([0-1][0-9])\-([0-3][0-9]) ([0-2][0-9])\:([0-5][0-9])\:([0-5][0-9]),([0-9][0-9][0-9])
rule = type ^(\d{4}-[01]\d-[0-3]\dT[0-2]\d:[0-5]\d:[0-5]\d\.\d+([+-][0-2]\d:[0-5]\d|Z))
rule = type ^(\d{4}-[01]\d-[0-3]\dT[0-2]\d:[0-5]\d:[0-5]\d([+-][0-2]\d:[0-5]\d|Z))
rule = type ^(\d{4}-[01]\d-[0-3]\dT[0-2]\d:[0-5]\d([+-][0-2]\d:[0-5]\d|Z))
rule = type ^(\d{4}-[01]\d-[0-3]\dT[0-2]\d:[0-5]\d:[0-5]\d\.\d+([+-][0-2]\d:[0-5]\d|Z))|(\d{4}-[01]\d-[0-3]\dT[0-2]\d:[0-5]\d:[0-5]\d([+-][0-2]\d:[0-5]\d|Z))|(\d{4}-[01]\d-[0-3]\dT[0-2]\d:[0-5]\d([+-][0-2]\d:[0-5]\d|Z))
rule = type ^(\d{4}-[01]\d-[0-3]\dT[0-2]\d:[0-5]\d:[0-5]\d\.\d+)
rule = type ^(\d{4}-[01]\d-[0-3]\dT[0-2]\d:[0-5]\d:[0-5]\d)
rule = type ^(\d{4}-[01]\d-[0-3]\dT[0-2]\d:[0-5]\d)
rule = type ^(\d{4}-[01]\d-[0-3]\dT[0-2]\d:[0-5]\d:[0-5]\d\.\d+)|(\d{4}-[01]\d-[0-3]\dT[0-2]\d:[0-5]\d:[0-5]\d)|(\d{4}-[01]\d-[0-3]\dT[0-2]\d:[0-5]\d)
