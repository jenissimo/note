# Converted from micro's 'PowerShell.yaml' syntax file.
# Upstream: zyedidia/micro (MIT). See NOTICE.md.
# Lossy on purpose: note's lexer keeps word lists and
# delimiters, not micro's regular expressions.

name = PowerShell
extensions = ps1 psm1 psd1
line_comment = #
block_comment = <# #>
quotes = "'
keywords = alias as begin break catch continue data default define do dynamicparam else elseif end exit finally for foreach from if in inlinescript parallel param process return switch throw trap try until using var where while
rule = type class +[A-Za-z0-9]+ *((:) +[A-Za-z0-9.]+)?
rule = type (function)(?:([ \t\r\n\f\v][A-Za-z0-9]+[ \t\r\n\f\v]*))
rule = type (Add|Approve|Assert|Backup|Block|Build|Checkpoint|Clear|Close|Compare|Complete|Compress|Confirm|Connect|Convert|ConvertFrom|ConvertTo|Copy)[-][A-Za-z0-9]+
rule = type (Debug|Deny|Deploy|Disable|Disconnect|Dismount|Edit|Enable|Enter|Exit|Expand|Export|Find|Format|Get|Grant|Group|Hide)[-][A-Za-z0-9]+
rule = type (Import|Initialize|Install|Invoke|Join|Limit|Lock|Measure|Merge|Mount|Move|New|Open|Optimize|Out|Ping|Pop|Protect|Publish|Push)[-][A-Za-z0-9]+
rule = type (Read|Receive|Redo|Register|Remove|Rename|Repair|Request|Reset|Resize|Resolve|Restart|Restore|Resume|Revoke)[-][A-Za-z0-9]+
rule = type (Save|Search|Select|Send|Set|Show|Skip|Split|Start|Step|Stop|Submit|Suspend|Switch|Sync|Test|Trace)[-][A-Za-z0-9]+
rule = type (Unblock|Undo|Uninstall|Unlock|Unprotect|Unpublish|Unregister|Update|Use|Wait|Watch|Write)[-][A-Za-z0-9]+
rule = type \[\b([A-Za-z]+|[A-Za-z]+[0-9]+)\b\]
rule = keyword \b(foreach-object)\b
rule = keyword \b(where-object)\b
rule = operator (\{|\})
rule = operator (\(|\))
rule = operator (\[|\])
rule = operator [\-+/*=<>?:!~%&|]
rule = operator [ \t\r\n\f\v][-](ne|eq|gt|ge|lt|le|like|notlike|match|notmatch|contains|notcontains|in|notin|replace|is|isnot)[ \t\r\n\f\v]
rule = keyword \b\$(true|false|null)\b
rule = number \b([0-9._]+|0x[A-Fa-f0-9_]+|0b[0-1_]+)[FL]?\b
