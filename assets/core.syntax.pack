types = cd command echo eval export getopts let local read set shift time umask unset bash dash find getopt kill killall make pkill sed sh tar base64 basename cat chcon chgrp chmod chown chroot cksum comm cp csplit cut date dd df dir dircolors dirname du env expand expr factor false fmt fold head hostid id install join link ln logname ls md5sum mkdir mkfifo mknod mktemp mv nice nl nohup nproc numfmt od paste pathchk pinky pr printenv printf ptx pwd readlink realpath rm rmdir runcon seq shred shuf sleep sort split stat stdbuf stty sum sync tac tail tee test timeout touch tr true truncate tsort tty uname unexpand uniq unlink users vdir wc who whoami yes
rule = number \b[0-9]+\b
rule = operator [`$<>!=&~^\{\}\(\)\;\]\[]+
rule = type \b((g|ig)?awk|\w{0,4}grep|\w{0,4}less)\b
rule = type \b((sha1|sha224|sha256|sha384|sha512)sum)\b
rule = keyword (\s|^)(--?[A-Za-z0-9][\w-]*)
rule = type \$\{[\w:!%&=+#~@*^$?, .\-\/\[\]]+\}
rule = type \$([0-9!#@*$?-]|[A-Za-z_]\w*)
